      <div class="links">
        <a class="r" href="https://linkedin.com/in/calvinyzhou" target="_blank" rel="noopener">LinkedIn <span class="ar">↗</span></a>
        <a class="r" href="mailto:czhou6@engineering.upenn.edu">Email <span class="ar">↗</span></a>
